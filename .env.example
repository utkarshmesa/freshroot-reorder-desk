# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude) - explanations + weekly brief only
ANTHROPIC_API_KEY=
LLM_MODEL=

# Zoho Inventory (server-side only; dedicated integration user)
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=         # production: read + purchaseorders.CREATE; preview/dev: READ-ONLY scopes (ADR-0005)
ZOHO_ORGANIZATION_ID=
# Scopes to request (no UPDATE/DELETE):
# ZohoInventory.purchaseorders.READ,ZohoInventory.purchaseorders.CREATE,ZohoInventory.purchasereceives.READ,ZohoInventory.items.READ,ZohoInventory.contacts.READ,ZohoInventory.settings.READ

# App
APP_MODE=shadow            # shadow | live  (only Deepa switches to live, via Settings)
APP_TIMEZONE=Asia/Kolkata
ALERT_EMAIL_FROM=
RESEND_API_KEY=            # alerts (C-027); server-side only
CRON_SECRET=
